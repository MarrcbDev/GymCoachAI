# Copia este archivo como functions/.env y ajusta los valores antes de desplegar.
# Modelos que los usuarios con cuenta pueden elegir (separados por coma). El primero es el predeterminado.
ALLOWED_MODELS=gpt-4o-mini
# Mensajes por usuario y por día con el servicio incluido.
DAILY_LIMIT=30
# Zona horaria para el reinicio diario del límite.
QUOTA_TIMEZONE=America/Bogota
# Tope de tokens de salida por respuesta (súbelo si usas modelos de razonamiento).
MAX_OUTPUT_TOKENS=1500
